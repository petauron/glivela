diff --git a/app/router/glivela_target_test.go b/app/router/glivela_target_test.go
new file mode 100644
index 0000000..c5f6f4a
--- /dev/null
+++ b/app/router/glivela_target_test.go
@@ -0,0 +1,45 @@
+package router
+
+import (
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+func TestGlivelaTargetSelectionKeepsOriginalIdentityAndPort(t *testing.T) {
+	L := newLuaRouterState(t, `
+assert(require("xray.router").TargetSelectionRevision == 1)
+function HandleRoute(ctx)
+    local original = ctx:GetOriginalTargetIPs()
+    assert(#original == 1 and original[1]:String() == "1.1.1.1")
+    assert(ctx:GetOriginalTargetDomain() == "")
+    ctx:SetTargetIP(original, 1)
+    return "selected", "literal"
+end`)
+	user := &protocol.MemoryUser{Email: "fixture"}
+	original := net.TCPDestination(net.ParseAddress("1.1.1.1"), 443)
+	ctx := &routing_session.Context{
+		Inbound: &session.Inbound{User: user},
+		Outbound: &session.Outbound{OriginalTarget: original,
+			Target:      net.TCPDestination(net.DomainAddress("sniffed.example.com"), 443),
+			RouteTarget: net.TCPDestination(net.DomainAddress("route.example.com"), 443)},
+	}
+	if err := callLuaRoute(L, ctx); err != nil {
+		t.Fatal(err)
+	}
+	if ctx.Outbound.Target != original || ctx.Outbound.OriginalTarget != original || ctx.Outbound.RouteTarget.IsValid() || ctx.Inbound.User != user {
+		t.Fatal("selection changed credentials, port, original target, or kept a routing alias")
+	}
+}
+
+func TestGlivelaTargetSelectionRejectsNonSessionAndInvalidIndex(t *testing.T) {
+	for _, body := range []string{"ctx:GetOriginalTargetIPs()", "ctx:SetTargetIP(ctx:GetTargetIPs(), 0)"} {
+		L := newLuaRouterState(t, "function HandleRoute(ctx) "+body+" end")
+		if err := callLuaRoute(L, newLuaRouteTestContext()); err == nil {
+			t.Fatal("unsafe mutation accepted without a real original session")
+		}
+	}
+}
diff --git a/app/dns/glivela_nodata_test.go b/app/dns/glivela_nodata_test.go
new file mode 100644
index 0000000..de02cfa
--- /dev/null
+++ b/app/dns/glivela_nodata_test.go
@@ -0,0 +1,35 @@
+package dns
+
+import (
+	"errors"
+	"testing"
+
+	xlua "github.com/xtls/xray-core/common/lua"
+	featureDNS "github.com/xtls/xray-core/features/dns"
+	lua "github.com/yuin/gopher-lua"
+)
+
+func TestGlivelaNoDataRequiresExactSuccessfulEmptyEvidence(t *testing.T) {
+	L := lua.NewState()
+	defer L.Close()
+	registerLua(L, nil, nil)
+	for _, test := range []struct {
+		err  error
+		want bool
+	}{
+		{nil, false}, {featureDNS.ErrEmptyResponse, true},
+		{featureDNS.RCodeError(3), false}, {featureDNS.RCodeError(2), false},
+		{errors.New("timeout"), false},
+		{errors.Join(featureDNS.ErrEmptyResponse, errors.New("timeout")), false},
+	} {
+		xlua.PushError(L, test.err)
+		L.SetGlobal("e", L.Get(-1))
+		L.Pop(1)
+		if err := L.DoString("result = require('xray.dns').IsNoData(e)"); err != nil {
+			t.Fatal(err)
+		}
+		if L.GetGlobal("result") != lua.LBool(test.want) {
+			t.Fatal("DNS failure was confused with NODATA")
+		}
+	}
+}
